# Postgres on AWS RDS
# sslmode=require is recommended for RDS; drop it only if your instance's parameter group disables SSL enforcement
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<rds-endpoint>:5432/templatehub?sslmode=require

# S3
AWS_REGION=<e.g. ap-south-1>
S3_BUCKET_NAME=<your-bucket-name>
# Leave both blank to use the default AWS credential chain (`aws configure` / IAM role) instead
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock — authenticates separately from S3. The key is a bearer token (ABSK...),
# NOT an access-key pair: putting it in AWS_ACCESS_KEY_ID shadows the S3 credentials
# above and authenticates nothing. botocore reads this variable from the environment.
AWS_BEARER_TOKEN_BEDROCK=
# Defaults to AWS_REGION when blank
BEDROCK_REGION=

# Optional overrides
MAX_UPLOAD_SIZE_MB=25
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
