# Postgres on AWS RDS
# sslmode=require is recommended for RDS; drop it only if your instance's parameter group disables SSL enforcement
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<rds-endpoint>:5432/templatehub?sslmode=require

# S3
AWS_REGION=<e.g. ap-south-1>
S3_BUCKET_NAME=<your-bucket-name>
# Leave both blank to use the default AWS credential chain (`aws configure` / IAM role) instead
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional overrides
MAX_UPLOAD_SIZE_MB=25
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# ── Auth ──────────────────────────────────────────────────────────────────
# Anything other than local/dev/development makes the app refuse to start on the
# built-in development JWT secret, and turns off echoing OTPs in API responses.
APP_ENV=local
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=720

# ── Email ─────────────────────────────────────────────────────────────────
# Leave SMTP_HOST blank and every message (OTPs, approval notifications) is
# written to the server log in full instead of being sent, which is enough to
# run the whole flow locally. Fill it in and the same messages go out for real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=TemplateHub <no-reply@yamaha-motor-india.com>

# Returns the OTP in the API response so local work needs no mailbox. Ignored
# unless APP_ENV is local *and* SMTP_HOST is blank.
OTP_DEBUG=true

# ── First administrator ───────────────────────────────────────────────────
# Read only by `scripts/seed_admin.py`, never at request time. Run it once:
#   uv run python scripts/seed_admin.py
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=Doc Control
