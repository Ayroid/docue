# Postgres. Local: `docker compose up -d postgres` (see docker-compose.yml).
# In production, point this at a real instance and add sslmode=require.
DATABASE_URL=postgresql+psycopg2://templatehub:templatehub@localhost:5432/templatehub

# S3 -- MinIO locally (docker compose up -d minio), real AWS S3 in production
AWS_REGION=<e.g. us-east-1 for MinIO, or your real AWS region>
S3_BUCKET_NAME=<your-bucket-name>
# MinIO root user/password locally; leave blank for the default AWS credential
# chain (`aws configure` / IAM role) against real S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set to http://localhost:9000 for local MinIO. Leave blank for real AWS S3.
S3_ENDPOINT_URL=

# ── LLM proxy ─────────────────────────────────────────────────────────────
# An OpenAI-API-compatible proxy (chat completions + embeddings). Point this
# at whatever instance you run locally.
LLM_BASE_URL=http://localhost:3001/v1
LLM_API_KEY=
# "auto" lets the proxy choose a default chat backend.
LLM_CHAT_MODEL=auto
# Must stay pinned to a 1024-dimension embedding family to match
# `templates.embedding VECTOR(1024)` (see alembic/versions/0001_initial_schema.py).
# Do NOT use "auto" here -- the proxy's default embedding family may be a
# different width. nv-embedqa-e5-v5 (nvidia, 1024-dim, free) is confirmed
# working; other 1024-dim families exist too but their no-key providers may
# be rate-limited or unavailable at any given time -- check the proxy's own
# model list if this one stops working.
LLM_EMBEDDING_MODEL=nv-embedqa-e5-v5

# Optional overrides
MAX_UPLOAD_SIZE_MB=25
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# ── Auth ──────────────────────────────────────────────────────────────────
# Anything other than local/dev/development makes the app refuse to start on the
# built-in development JWT secret, and turns off echoing OTPs in API responses.
APP_ENV=local
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=720

# ── Email ─────────────────────────────────────────────────────────────────
# Leave SMTP_HOST blank and every message (OTPs, approval notifications) is
# written to the server log in full instead of being sent, which is enough to
# run the whole flow locally. Fill it in and the same messages go out for real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=TemplateHub <no-reply@yamaha-motor-india.com>

# Returns the OTP in the API response so local work needs no mailbox. Ignored
# unless APP_ENV is local *and* SMTP_HOST is blank.
OTP_DEBUG=true

# ── First administrator ───────────────────────────────────────────────────
# Read only by `scripts/seed_admin.py`, never at request time. Run it once:
#   uv run python scripts/seed_admin.py
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=Admin
